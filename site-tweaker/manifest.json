{
  "manifest_version": 3,
  "name": "网页定制 - 自定义 CSS / JS",
  "short_name": "网页定制",
  "version": "1.2.0",
  "description": "为指定网站注入你自己的 CSS 样式和 JavaScript 脚本，让网页按你喜欢的样子运行。",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting", "userScripts"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/rules.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "网页定制",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "commands": {
    "start-picker": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "快捷消除：点选隐藏网页元素"
    },
    "toggle-viewer": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "打开/关闭代码小窗"
    }
  }
}
